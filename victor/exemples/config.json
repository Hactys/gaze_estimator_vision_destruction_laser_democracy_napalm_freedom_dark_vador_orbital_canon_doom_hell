      },
      {
        "texte": "Coller",
        "action": "touches CTRL+V"
      },
      {
        "texte": "Écrire bonjour",
        "action": "ecrire \"Bonjour, comment ça va ?\""
      },
      {
        "texte": "Raccourcis",
        "action": "ouvrir Raccourcis",
        "couleur": "violet"
      },
      {
        "texte": "Oui",
        "action": "ecrire \"Oui\"",
        "couleur": "vert"
      },
      {
        "texte": "Non",
        "action": "ecrire \"Non\"",
        "couleur": "rouge"
      },
      {
        "texte": "Entrée",
        "action": "touches ENTREE"
      },
      {
        "texte": "Effacer",
        "action": "touches RETOUR_ARRIERE"
      },
      {
        "texte": "Tout sélectionner et copier",
        "action": "touches CTRL+A CTRL+C"
      }
    ],
    "Raccourcis": [
      {
        "texte": "Annuler",
        "action": "touches CTRL+Z",
        "duree_clic": 3
      },
      {
        "texte": "Navigateur",
        "action": "ouvrir Navigateur",
        "couleur": "bleu"
      }
    ],
    "Navigateur": [
      {
        "texte": "Nouvel onglet",
        "action": "touches CTRL+T"
      },
      {
        "texte": "Fermer l'onglet",
